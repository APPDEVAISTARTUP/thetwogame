{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "twoofficial",
      "version": "0.1.0",
      "title": "TWOOFFICIAL"
    },
    "tools": [
      {
        "name": "get_game_info",
        "title": "Get game info",
        "description": "Get public overview information about the game TWO: genre, engine, platform, developer, setting, design pillars and official links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_roadmap",
        "title": "Get development roadmap",
        "description": "Get the public development roadmap phases for TWO, in order.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_support_info",
        "title": "Get support / donation info",
        "description": "Get public crowdfunding details for TWO, including the UPI ID and a UPI deep link for an optional donation amount in INR.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "amountInr": {
              "description": "Optional donation amount in Indian Rupees.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_supporters",
        "title": "List public supporters",
        "description": "List the most recent public supporters shown on the TWO supporters wall (display name, amount, message).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many supporters to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
